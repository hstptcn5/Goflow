{
  "schema_version": 1,
  "id": "official.daily-business-report",
  "name": "Daily Business Report",
  "version": "0.10.0",
  "description": "Fetch a normalized daily business snapshot and deliver one Telegram report in English or Vietnamese, with optional OpenAI or DeepSeek commentary.",
  "entry_workflow": "workflows/main.json",
  "required_credentials": [],
  "supported_platforms": ["windows-amd64", "linux-amd64", "linux-arm64", "darwin-amd64", "darwin-arm64"],
  "assets": ["README.md", "CHANGELOG.md", "locales.json"],
  "required_capabilities": [
    "goflow.pack.v1",
    "goflow.setup.bindings.v1",
    "goflow.setup.connection-tests.v1",
    "goflow.schedule.daily.v1",
    "goflow.migration.host-managed.v1"
  ],
  "offline_test_fixture": "tests/offline.json",
  "config_schema": [
    {
      "key": "source_url",
      "label": "Business data URL",
      "description": "Absolute HTTP(S) endpoint returning the Daily Business Report JSON contract. The public sample is safe for your first test.",
      "type": "url",
      "required": true,
      "test_kind": "http_json_contract",
      "default": "https://raw.githubusercontent.com/hstptcn5/Goflow/daily-business-report-v0.10.0-beta.1/examples/packs/daily-business-report/sample-source.json"
    },
    {
      "key": "chat_id",
      "label": "Telegram chat ID",
      "description": "Chat, group, or channel that should receive the daily report.",
      "type": "string",
      "required": true,
      "min_length": 1,
      "max_length": 120
    },
    {
      "key": "output_language",
      "label": "Report language",
      "description": "Choose the language used in the delivered report.",
      "type": "select",
      "required": true,
      "default": "en",
      "options": ["en", "vi"]
    },
    {
      "key": "ai_provider",
      "label": "AI commentary",
      "description": "Leave this at none for the first run. Choose openai or deepseek only after the deterministic report works.",
      "type": "select",
      "required": true,
      "default": "none",
      "options": ["none", "openai", "deepseek"]
    }
  ],
  "credential_requirements": [
    {
      "key": "telegram",
      "label": "Telegram bot token",
      "description": "Required. Encrypted bot token used to deliver the report.",
      "type": "TELEGRAM_BOT",
      "required": true,
      "test_kind": "telegram_get_me"
    },
    {
      "key": "openai",
      "label": "OpenAI API key (optional)",
      "description": "Optional. Add this only when AI commentary is set to openai.",
      "type": "OPENAI_API_KEY",
      "required": false
    },
    {
      "key": "deepseek",
      "label": "DeepSeek API key (optional)",
      "description": "Optional. Add this only when AI commentary is set to deepseek.",
      "type": "DEEPSEEK_API_KEY",
      "required": false
    }
  ],
  "bindings": [
    { "source": "config.source_url", "target": { "node_id": "fetch_business", "param": "url" } },
    { "source": "config.output_language", "target": { "node_id": "locale_vi", "param": "field" } },
    { "source": "config.ai_provider", "target": { "node_id": "use_ai_en", "param": "field" } },
    { "source": "config.ai_provider", "target": { "node_id": "use_openai_en", "param": "field" } },
    { "source": "config.ai_provider", "target": { "node_id": "use_ai_vi", "param": "field" } },
    { "source": "config.ai_provider", "target": { "node_id": "use_openai_vi", "param": "field" } },
    { "source": "config.chat_id", "target": { "node_id": "send_plain_en", "param": "chat_id" } },
    { "source": "config.chat_id", "target": { "node_id": "send_openai_en", "param": "chat_id" } },
    { "source": "config.chat_id", "target": { "node_id": "send_deepseek_en", "param": "chat_id" } },
    { "source": "config.chat_id", "target": { "node_id": "send_plain_vi", "param": "chat_id" } },
    { "source": "config.chat_id", "target": { "node_id": "send_openai_vi", "param": "chat_id" } },
    { "source": "config.chat_id", "target": { "node_id": "send_deepseek_vi", "param": "chat_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_plain_en", "param": "credential_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_openai_en", "param": "credential_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_deepseek_en", "param": "credential_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_plain_vi", "param": "credential_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_openai_vi", "param": "credential_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_deepseek_vi", "param": "credential_id" } },
    { "source": "credential.openai", "target": { "node_id": "openai_summary_en", "param": "credential_id" } },
    { "source": "credential.openai", "target": { "node_id": "openai_summary_vi", "param": "credential_id" } },
    { "source": "credential.deepseek", "target": { "node_id": "deepseek_summary_en", "param": "credential_id" } },
    { "source": "credential.deepseek", "target": { "node_id": "deepseek_summary_vi", "param": "credential_id" } }
  ]
}
