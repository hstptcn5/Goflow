{
  "schema_version": 1,
  "id": "official.daily-business-report",
  "name": "Daily Business Report",
  "version": "0.9.0",
  "description": "Fetch a normalized daily business snapshot and deliver one Telegram report, with optional OpenAI or DeepSeek commentary.",
  "entry_workflow": "workflows/main.json",
  "required_credentials": [],
  "supported_platforms": [
    "windows-amd64",
    "linux-amd64",
    "linux-arm64",
    "darwin-amd64",
    "darwin-arm64"
  ],
  "assets": [
    "README.md",
    "CHANGELOG.md"
  ],
  "required_capabilities": [
    "goflow.pack.v1",
    "goflow.setup.bindings.v1",
    "goflow.setup.connection-tests.v1",
    "goflow.schedule.daily.v1",
    "goflow.migration.host-managed.v1"
  ],
  "offline_test_fixture": "tests/offline.json",
  "config_schema": [
    {
      "key": "source_url",
      "label": "Business data URL",
      "description": "Absolute HTTP(S) endpoint returning the Daily Business Report JSON contract.",
      "type": "url",
      "required": true,
      "test_kind": "http_json_contract",
      "default": "https://example.test/daily-business-report.json"
    },
    {
      "key": "chat_id",
      "label": "Telegram chat ID",
      "description": "Chat, group, or channel that should receive the daily report.",
      "type": "string",
      "required": true,
      "default": "@daily_business_report_demo",
      "min_length": 1,
      "max_length": 120
    },
    {
      "key": "ai_provider",
      "label": "AI commentary",
      "description": "Use none for deterministic reporting, or enter/select openai or deepseek after saving the matching optional API key.",
      "type": "select",
      "required": true,
      "default": "none",
      "options": ["none", "openai", "deepseek"]
    }
  ],
  "credential_requirements": [
    {
      "key": "telegram",
      "label": "Telegram bot token",
      "description": "Required. Encrypted bot token used to deliver the report.",
      "type": "TELEGRAM_BOT",
      "required": true,
      "test_kind": "telegram_get_me"
    },
    {
      "key": "openai",
      "label": "OpenAI API key",
      "description": "Optional. Add this only when AI commentary is set to openai.",
      "type": "OPENAI_API_KEY",
      "required": false
    },
    {
      "key": "deepseek",
      "label": "DeepSeek API key",
      "description": "Optional. Add this only when AI commentary is set to deepseek.",
      "type": "DEEPSEEK_API_KEY",
      "required": false
    }
  ],
  "bindings": [
    { "source": "config.source_url", "target": { "node_id": "fetch_business", "param": "url" } },
    { "source": "config.ai_provider", "target": { "node_id": "use_ai", "param": "field" } },
    { "source": "config.ai_provider", "target": { "node_id": "use_openai", "param": "field" } },
    { "source": "config.chat_id", "target": { "node_id": "send_plain", "param": "chat_id" } },
    { "source": "config.chat_id", "target": { "node_id": "send_openai", "param": "chat_id" } },
    { "source": "config.chat_id", "target": { "node_id": "send_deepseek", "param": "chat_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_plain", "param": "credential_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_openai", "param": "credential_id" } },
    { "source": "credential.telegram", "target": { "node_id": "send_deepseek", "param": "credential_id" } },
    { "source": "credential.openai", "target": { "node_id": "openai_summary", "param": "credential_id" } },
    { "source": "credential.deepseek", "target": { "node_id": "deepseek_summary", "param": "credential_id" } }
  ]
}
