# Goflow example environment
#
# Copy this file to .env only if your launcher loads .env files, or set these
# variables directly in your shell before starting Goflow.

# Local bind address. Keep 127.0.0.1 for local-only use.
GOFLOW_HOST=127.0.0.1
GOFLOW_PORT=8080

# Required when binding outside localhost. Recommended for any shared machine.
# Goflow API clients use: Authorization: Bearer <GOFLOW_API_KEY>
GOFLOW_API_KEY=change-me

# Optional explicit storage paths.
GOFLOW_DB_PATH=goflow.db
GOFLOW_MASTER_KEY_FILE=goflow.master.key

# Execution safety limits.
GOFLOW_MAX_CONCURRENT_EXECUTIONS=10
GOFLOW_MAX_PARALLEL_NODES_PER_EXECUTION=4
GOFLOW_EXECUTION_RETENTION_DAYS=30
GOFLOW_MAX_EXECUTIONS_PER_WORKFLOW=1000

# Webhook and MCP safety limits.
GOFLOW_WEBHOOK_RATE_LIMIT_PER_MINUTE=60
GOFLOW_MCP_RATE_LIMIT_PER_MINUTE=30
GOFLOW_MCP_MAX_INFLIGHT_PER_CLIENT=2

# HTTP MCP deployment settings.
# Use exact origins when exposing /mcp to browser or remote clients.
GOFLOW_MCP_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
GOFLOW_MCP_BASE_URL=http://127.0.0.1:8080
